Table user {
  id integer [primary key]
  address_id integer
  first_name varchar(255)
  last_name varchar(255)
  email varchar(255) [unique]
  mobile varchar(20)
  role varchar(50)
  password varchar(255)
  created_at timestamp
  updated_at timestamp
  is_delete bool
}

Table book {
  id integer [primary key]
  seller_id integer 
  category_id integer
  publication_id integer
  author_id integer
  book_image_id integer
  title varchar(255)
  isbn varchar(20) [unique]
  description text
  stock integer
  actual_price decimal
  discount decimal
  created_at timestamp 
  updated_at timestamp
}

Table author {
  id integer [primary key]
  first_name varchar(255)
  last_name varchar(255)
  email varchar(255) [unique]
  bio text
  created_at timestamp 
  updated_at timestamp
}

Table address {
  id integer [primary key]
  user_id integer
  address text
  created_at timestamp 
  updated_at timestamp
}

Table book_category {
  id integer [primary key]
  name varchar(255)
  created_at timestamp
}

Table book_publication {
  id integer [primary key]
  name varchar(255)
  created_at timestamp
}
Table book_images {
  id integer [primary key]
  front_image varchar(255)
  back_image varchar(255)
  misc_image1 varchar(255)
  misc_image2 varchar(255)
  created_at timestamp
}

Table order {
  id integer [primary key]
  user_id integer
  total_amount decimal
  status varchar(50)
  created_at timestamp 
  updated_at timestamp
}

Table order_detail {
  id integer [primary key]
  book_id integer
  order_id integer
  books_quantity integer
  price decimal
  status varchar(50)
  created_at timestamp 
  updated_at timestamp
}

Table cart_item {
  id integer [primary key]
  book_id integer
  user_id integer
  quantity integer
  created_at timestamp 
  updated_at timestamp
}


// Updated Mappings
Ref: "user"."address_id" < "address"."id"
Ref: "user"."id" < "book"."seller_id"
Ref: "book"."category_id" > "book_category"."id"
Ref: "book"."author_id" > "author"."id"
Ref: "user"."id" < "order"."user_id"
Ref: "user"."id" < "cart_item"."user_id"
Ref: "book"."id" > "cart_item"."book_id"
Ref: "book"."id" > "order_detail"."book_id"
Ref: "order"."id" < "order_detail"."order_id"

Ref: "book_publication"."id" < "book"."publication_id"

